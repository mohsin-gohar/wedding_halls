# ==============================================================================
# EVENTHUB — HOSTINGER PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# INSTRUCTIONS FOR HOSTINGER:
# 1. In Hostinger hPanel -> File Manager, duplicate this file and rename to: .env
# 2. Run in Hostinger SSH Terminal: php artisan key:generate
# 3. Enter your Hostinger MySQL Database details below (from hPanel -> Databases)
# ==============================================================================

APP_NAME="EventHub"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=daily
LOG_LEVEL=error

# ------------------------------------------------------------------------------
# HOSTINGER MYSQL DATABASE CONFIGURATION
# (Find these in Hostinger hPanel -> Databases -> MySQL Databases)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u123456789_eventhub
DB_USERNAME=u123456789_dbuser
DB_PASSWORD="YourStrongHostingerDbPasswordHere"

# ------------------------------------------------------------------------------
# DRIVERS (Optimized for Shared / Cloud Hosting on Hostinger)
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# ------------------------------------------------------------------------------
# HOSTINGER EMAIL CONFIGURATION (Optional: hPanel -> Emails -> Webmail / SMTP)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=info@your-domain.com
MAIL_PASSWORD="YourEmailPassword"
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="info@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------------------------------------
BCRYPT_ROUNDS=12
VITE_APP_NAME="${APP_NAME}"
