# ==============================================================================
# RIWAJ GRAND — PRODUCTION ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy to .env on the server, then run: php artisan key:generate
# Never commit the resulting .env. All values below are placeholders.
# The Hostinger notes are optional guidance; any PHP 8.2 + MySQL host works.
# ==============================================================================

APP_NAME="Riwaj Grand"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com
# Required only for the Docker Compose + Caddy deployment:
APP_DOMAIN=your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=daily
LOG_LEVEL=warning

# ------------------------------------------------------------------------------
# MYSQL — use the credentials issued by your host (hPanel -> Databases on Hostinger)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD="replace-with-a-strong-database-password"
# Docker Compose only: the MySQL container's root password. Leave unset for a
# managed/shared MySQL host that does not expose a root account to the app.
DB_ROOT_PASSWORD="replace-with-a-strong-root-password"

# ------------------------------------------------------------------------------
# SHARED RUNTIME DRIVERS (required for multi-instance correctness)
# ------------------------------------------------------------------------------
# CACHE_STORE=database is shared through the `cache_locks` table. Do NOT use
# `file` or `array` in production: reservation mutexes would be local to one
# server and two instances could double-book the same hall/date.
CACHE_STORE=database
BOOKING_LOCK_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public
# Confidential payment proofs must stay on a private (non-public) disk.
PROOFS_FILESYSTEM_DISK=local

# Behind Cloudflare / a load balancer, list only the actual trusted proxy IPs/CIDRs.
# Leave empty for direct Hostinger/LiteSpeed HTTPS termination. Never use '*'
# on a publicly reachable PHP app. Docker Compose sets '*' only because its
# PHP-FPM service is private and reachable solely through the internal edge.
# TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8

# ------------------------------------------------------------------------------
# MAIL (optional — use your host's SMTP details)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=notifications@your-domain.com
MAIL_PASSWORD="replace-with-your-smtp-password"
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="notifications@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------------------------------------
BCRYPT_ROUNDS=12
VITE_APP_NAME="${APP_NAME}"
