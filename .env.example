APP_NAME="Riwaj Grand"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Production defaults to MySQL. MySQL ONLY (final state, 17 Nov 2026 — SQLite fallback removed).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=riwaj_grand
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=null
# Set SESSION_SECURE_COOKIE=true in production behind TLS proxy
SESSION_SAME_SITE=lax

# Production-grade runtime (recommended): set Redis-backed drivers and ensure Redis is running.
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# SESSION_DRIVER=redis
# SESSION_ENCRYPT=true
# SESSION_SECURE_COOKIE=true
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Confidential payment proofs must stay on a private (non-public) disk.
PROOFS_FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# Cache store used for the booking reservation mutex. It must be a shared store
# (database/redis) whenever more than one app instance can accept bookings.
BOOKING_LOCK_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# CORS (used by config/cors.php). Comma-separated origins; prefer explicit origins in production.
CORS_ALLOWED_ORIGINS=
CORS_SUPPORTS_CREDENTIALS=false

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Mailgun (transactional email) — set MAIL_MAILER=mailgun to use
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# WhatsApp Cloud API (Meta) — two-way RSVP webhook + outbound dispatch
# Leave access_token/phone_number_id empty to run in sandbox (log-only) mode.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v19.0

# Production security toggles
# FORCE_HTTPS=true once deployed behind TLS (Nginx/Cloudflare/LB with trusted proxies)
FORCE_HTTPS=false
# SECURITY_HEADERS_CSP=true emits a baseline CSP + security headers via middleware.
# Set to false if CSP is served by Nginx/Cloudflare instead.
SECURITY_HEADERS_CSP=true

VITE_APP_NAME="${APP_NAME}"

# Launch promotion & module toggles (see config/platform.php)
BILLING_ENABLED=false
KITCHEN_MODULE_ENABLED=false
FREE_ACCESS_DAYS=30

# ==========================================
# Enterprise Configuration
# ==========================================

# Payments — cash only (manual staff verification, no gateway credentials)

# Two-Factor Authentication
TWO_FACTOR_ENABLED=true

# Search (Meilisearch/Algolia)
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

# Real-time Notifications (Pusher/Echo)
BROADCAST_DRIVER=log
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# SMS Gateway (Twilio or local Pakistani gateway)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# SMS Local Gateway (Pakistani providers)
# SMS_DRIVER: log (default, no real delivery), http (real gateway), null (disabled)
SMS_DRIVER=log
SMS_GATEWAY_URL=
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=
SMS_GATEWAY_SENDER_ID=RiwajGrand
SMS_TIMEOUT=10
# Only enable for a trusted local sandbox; production endpoints must use HTTPS.
SMS_ALLOW_INSECURE=false

# Sentry Error Tracking
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
